{{ ansible_managed | comment }}

set -g history-limit 10000
set -s escape-time 0
set -g status-right-length 80
set -g status-right "{{ packages_tmux_status_right }}"
set -g default-terminal "screen-256color"
set -g focus-events on
set-window-option -g mode-keys vi

# start windows and panes indexing from 1
set -g renumber-windows off
set -g base-index 1
set -g pane-base-index 1
set-window-option -g pane-base-index 1

# binds
unbind C-b
set -g prefix C-g
bind C-g send-prefix
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind g resize-pane -t 2 -x 90
bind '"' split-window -v -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind r source-file {{ packages_tmux_config_path }} \; display-message "updated"
bind -T copy-mode-vi 'v' send -X begin-selection
bind -T copy-mode-vi 'r' send -X rectangle-toggle

# tpm doesn't work well with fish installed by nix
set -g -a update-environment " PATH"
set -g default-shell {{ packages_fish_bin }}

# plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-battery'

set -g @plugin 'arcticicestudio/nord-tmux'
set -g @nord_tmux_show_status_content "0"

set -g @plugin 'tmux-plugins/tmux-yank'
set -g @yank_selection 'primary'

set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @resurrect-strategy-nvim 'session'
set -g @resurrect-capture-pane-contents 'on'
set -g @resurrect-dir {{ packages_tmux_resurrect_dir }}

set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @continuum-boot 'on'
set -g @continuum-restore 'on'

run -b '{{ packages_tmux_plugins_dir }}/tpm/tpm'
