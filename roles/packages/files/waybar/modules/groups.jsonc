{
  "group/language": {
    "orientation": "horizontal",
    "modules": [
      "niri/language"
    ]
  },
  "group/niri": {
    "orientation": "horizontal",
    "modules": [
      "niri/workspaces",
      "niri/window"
    ]
  },
  "group/storage": {
    "orientation": "horizontal",
    "modules": [
      "disk#boot",
      "disk#root"
    ]
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "temperature",
      "cpu",
      "memory"
    ]
  },
  "group/audio": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 650,
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider",
      "pulseaudio#microphone"
    ]
  },
  "group/connections": {
    "orientation": "horizontal",
    "modules": [
      "network"
    ]
  },
  "group/tray": {
    "orientation": "horizontal",
    "modules": [
      "tray",
      "custom/tray-arrow"
    ]
  }
}
