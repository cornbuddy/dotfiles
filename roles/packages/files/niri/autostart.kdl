spawn-at-startup "waybar"
// spawn-sh-at-startup "alacritty --title zellij --command zellij --layout welcome"
spawn-sh-at-startup "alacritty \"--option=window.startup_mode='Fullscreen'\" --title tmux --command tmux a -t `tmux ls -F \"#{session_name}\" | head -n1`"

spawn-at-startup "firefox"
spawn-at-startup "telegram-desktop"
spawn-at-startup "Telegram"

spawn-sh-at-startup "band-desktop --ozone-platform=wayland"
spawn-sh-at-startup "dbeaver"
