workspace ""
workspace ""
workspace "󰻞"
workspace ""

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match title="nmtui"
    open-floating true
}

window-rule {
    match app-id=r#"firefox$"#
    open-maximized true
    open-on-workspace ""
}

window-rule {
    match title=r#"tmux|zellij"#
    open-fullscreen true
    open-on-workspace ""
}

window-rule {
    match app-id="DBeaver"
    open-maximized true
    open-on-workspace ""
}

window-rule {
    match app-id=r#".*telegram.*|Band"#
    open-maximized false
    open-focused false
    open-on-workspace "󰻞"
}

window-rule {
    match app-id=r#".*telegram.*"# title="Media viewer"
    open-floating true
}
