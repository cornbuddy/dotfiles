{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "control-center-width": 500,
  "control-center-height": 600,
  "notification-window-width": 500,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "notification-grouping": true,
  "relative-timestamps": true,
  "fit-to-screen": true,
  "text-empty": "No notifications",
  "hide-on-action": true,
  "hide-on-clear": false,
  "notification-visibility": {
    "band": {
      "state": "enabled",
      "app-name": "Band",
      "override-urgency": "Critical"
    }
  },
  "widgets": [
    "inhibitors",
    "title",
    "dnd",
    "buttons-grid",
    "notifications"
  ],
  "widget-config": {
    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "⏻",
          "command": "loginctl poweroff"
        },
        {
          "label": "⟳",
          "command": "loginctl reboot"
        },
        {
          "label": "☾",
          "command": "loginctl suspend"
        }
      ]
    },
    "notifications": {
      "vexpand": true
    },
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "Clear All",
      "clear-all-button": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    }
  }
}
